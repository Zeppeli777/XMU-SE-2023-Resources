





























import numpy as np














a = np.array((0,1,2,3,4)) #将序列传入数组
b = np.arange(4) #返回间隔均匀的数组（默认步长为1）
c = np.ones((2,3)) #创建一个全为1的二维数组
d = np.zeros((2,3)) #创建一个全为0的二维数组
e = np.eye(3,3) #创建一个向左倾斜对角线上为1，其余为0的二维数组
f = np.linspace(0,9,num=3) #创建在指定间隔内返回均匀间隔的一维数组
print(a)
print(b)
print(c)
print(d)
print(e)
print(f)











