#10. 观察两棵树的结构，它们是否完全相同？如果不同，指出它们的差异之处。

# 两棵树的结构完全相同，因为它们都是基于相同的数据集和相同的划分标准构建的。
# 它们的节点划分和叶子节点的类别预测结果也一致。
# 不过通过accuracy可以看出基尼指数决策树的准确率略高于信息增益决策树。


#采用基尼指数作为不纯性度量的决策树分类器
class GiniDecisionTree:
    def __init__(self):
        pass
    
    def gini(self, y):      #计算基尼指数
        classes = np.unique(y)
        gini = 1.0
        for cls in classes:
            p_cls = np.mean(y == cls)
            gini -= p_cls ** 2
        return gini
    
    def gini_gain(self, X, y, feature_idx, threshold):     #计算基尼增益
        parent_gini = self.gini(y)
        left_idxs = X[:, feature_idx] < threshold
        right_idxs = ~left_idxs
        
        if np.sum(left_idxs) == 0 or np.sum(right_idxs) == 0:
            return 0
            
        # 计算加权平均的子节点基尼指数
        n_left = np.sum(left_idxs)
        n_right = np.sum(right_idxs)
        n_total = len(y)
        
        left_gini = self.gini(y[left_idxs])
        right_gini = self.gini(y[right_idxs])
        
        child_gini = (n_left/n_total) * left_gini + (n_right/n_total) * right_gini
        return parent_gini - child_gini
    
    def find_best_split(self, X, y):     #找出最优划分
        best_gain = 0
        best_feature_idx = None
        best_threshold = None
        for feature_idx in range(X.shape[1]):
            thresholds = np.unique(X[:, feature_idx])
            for threshold in thresholds:
                gain = self.gini_gain(X, y, feature_idx, threshold)
                if gain > best_gain:
                    best_gain = gain
                    best_feature_idx = feature_idx
                    best_threshold = threshold
        return best_feature_idx, best_threshold
    
    def fit(self, X, y):             #拟合数据
        if len(np.unique(y)) == 1:
            return {'class': y[0]}
        else:
            best_feature_idx, best_threshold = self.find_best_split(X, y)
            left_idxs = X[:, best_feature_idx] < best_threshold
            right_idxs = ~left_idxs
            tree = {
                'feature_idx': best_feature_idx,
                'threshold': best_threshold,
                'left': self.fit(X[left_idxs], y[left_idxs]),
                'right': self.fit(X[right_idxs], y[right_idxs])
            }
            return tree
    
    def predict_sample(self, sample, tree):
        if 'class' in tree:
            return tree['class']
        else:
            if sample[tree['feature_idx']] < tree['threshold']:
                return self.predict_sample(sample, tree['left'])
            else:
                return self.predict_sample(sample, tree['right'])
    
    def predict(self, X, tree):
        return [self.predict_sample(sample, tree) for sample in X]

# 训练和测试基尼指数决策树
gini_dt = GiniDecisionTree()
gini_tree = gini_dt.fit(X_train, y_train)

# 预测
gini_y_pred = gini_dt.predict(X_test, gini_tree)

# 评估分类器的性能
print("基尼指数决策树性能评估:")
print("Accuracy:", accuracy_score(y_test, gini_y_pred))
print("\nClassification Report:")
print(classification_report(y_test, gini_y_pred, target_names=np.unique(target)))

